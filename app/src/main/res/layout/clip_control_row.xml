<?xml version="1.0" encoding="utf-8"?>
<!-- One editable timeline clip: trim start/end (A/B), speed, and filter toggle.
     Inflated once per picked video by MainActivity2 into the clip list. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <TextView
        android:id="@+id/clip_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textStyle="bold"
        tools:text="Clip 1 · sample.mp4 (00:10)" />

    <TextView
        android:id="@+id/clip_start_value"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        tools:text="Start 00:00" />

    <SeekBar
        android:id="@+id/clip_start"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:contentDescription="@string/video_clip_start_description" />

    <TextView
        android:id="@+id/clip_end_value"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        tools:text="End 00:10" />

    <SeekBar
        android:id="@+id/clip_end"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:contentDescription="@string/video_clip_end_description" />

    <TextView
        android:id="@+id/clip_speed_value"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        tools:text="Speed 1.00×" />

    <SeekBar
        android:id="@+id/clip_speed"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:contentDescription="@string/video_clip_speed_description" />

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/clip_filter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:checked="true"
        android:text="@string/video_clip_filter" />

</LinearLayout>
